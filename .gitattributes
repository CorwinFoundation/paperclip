# ---------------------------------------------------------------------------
# Global line-ending policy.
#
# The scanner's integrity guards hash raw file bytes against LF-based pinned
# sha256 digests (tools/tranche1_observational.py, upstream_pins.json, canary
# fingerprints, canonical-serialization fixtures). A CRLF checkout — e.g. on
# Windows with core.autocrlf=true — changes those bytes and fails the guards
# closed (ObservationalContractError: configuration sha256 mismatch). Force LF
# for every text file so a checkout is byte-identical on every OS.
#
# `text=auto` lets git auto-detect binary vs text (files with NUL bytes are left
# untouched), so this is safe even for undeclared binary blobs; the explicit
# `binary` lines below are belt-and-suspenders for known types.
#
# NOTE: adding this file does NOT rewrite files already in the working tree.
# Run a one-time normalization after adding it (see RENORMALIZE section at end).
# ---------------------------------------------------------------------------
* text=auto eol=lf

# --- Source & config: LF (explicit; several of these are sha256-pinned) ------
*.py     text eol=lf
*.pyi    text eol=lf
*.json   text eol=lf
*.jsonl  text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.conf   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.sql    text eol=lf
*.go     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.cjs    text eol=lf
*.csv    text eol=lf
*.xml    text eol=lf
*.sh     text eol=lf
*.ps1    text eol=lf
*.patch  text eol=lf
*.lock   text eol=lf
*.sum    text eol=lf
*.mod    text eol=lf
*.sha256 text eol=lf

# Extensionless / special-name text files that must stay LF on Windows too.
Dockerfile     text eol=lf
Caddyfile      text eol=lf
Makefile       text eol=lf
*.service      text eol=lf
*.service.in   text eol=lf
*.timer        text eol=lf
bin/*          text eol=lf
.githooks/*    text eol=lf

# --- Binary: never convert (freeze exact bytes) ------------------------------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.gz     binary
*.tgz    binary
*.tar    binary
*.zip    binary
*.whl    binary
*.sig    binary
*.pem    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary

# --- Pre-existing pinned/content-addressed paths (kept explicit) -------------
# Content-addressed JSONL must keep its manifest byte hash on every OS.
artifacts/beaaa-15688/*.jsonl text eol=lf
corpus/wave0/*.jsonl text eol=lf
# Accepted Paperclip candidate inventories are content-addressed artifacts.
artifacts/beaaa-18715/** text eol=lf
artifacts/beaaa-18720/** text eol=lf
.backbond-source-commit export-subst

# ---------------------------------------------------------------------------
# RENORMALIZE (one-time, after adding this file):
#   git add --renormalize .
#   git commit -m "Normalize line endings to LF (fix CRLF sha256 guard breakage)"
# If your working tree still shows CRLF afterward, refresh it:
#   git rm --cached -r . && git reset --hard
# Verify: git check-attr eol -- config/tranche1_zero_weight_observational.json
#   -> should report eol: lf
# ---------------------------------------------------------------------------

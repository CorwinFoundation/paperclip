# Artifact filenames must be Windows-portable: no colon, question mark,
# asterisk, angle bracket, quote, pipe, or trailing space/dot.
# Content-addressed Wave 0 JSONL must keep its manifest byte hash on every OS.
artifacts/beaaa-15688/*.jsonl text eol=lf
corpus/wave0/*.jsonl text eol=lf
# Accepted Paperclip candidate inventories are content-addressed artifacts.
# Preserve exact bytes across Windows and Unix checkouts.
artifacts/beaaa-18715/** text eol=lf
artifacts/beaaa-18720/** text eol=lf
.backbond-source-commit export-subst

# Linux runtime and service files must remain LF in Windows checkouts.
*.sh text eol=lf
demo-real-agent/systemd/*.service.in text eol=lf

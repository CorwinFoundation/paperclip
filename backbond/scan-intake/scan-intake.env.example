QA_DB_PATH=/var/lib/backbond-scan-intake/scan-intake.sqlite
QA_SCANNER_URL=https://scanner.backbond.ai/scanner/v1
QA_PUBLIC_API=https://api.backbond.ai
QA_TERMS_VERSION=v0.2.2
QA_READY=1
QA_TERMS_APPROVED=1
QA_REQUIRE_CONNECTION_PROOF=1
QA_PARTNER_CODE_REQUIRED=1
# BEAAA-42596 report release roles. sha256 hex of each bearer token; empty = role fails closed (503).
# The Analyst authors revisions; the Lead approves. The Lead token cannot author and an author cannot approve.
QA_RELEASE_LEAD_TOKEN_SHA256=
QA_RELEASE_LEAD_ACTOR_ID=
QA_RELEASE_ANALYST_TOKEN_SHA256=
QA_RELEASE_ANALYST_ACTOR_ID=
# Independent reviewer between Analyst and Lead; must be neither (distinct token and actor id).
QA_RELEASE_REVIEWER_TOKEN_SHA256=
QA_RELEASE_REVIEWER_ACTOR_ID=
# BEAAA-42596 Operations Starter intake: finished BAC-bound Starter results are recorded at
# ${QA_OPERATIONS_BASE_URL}/v1/starter-scans (https only) with the Operations integration bearer token.
# Operations writes the final report and sends it to info@backbond.ai; intake sends no report mail.
# The Starter page's report/delivery status is read back from .../v1/starter-scans/{bac_scan_id}/status.
# Either empty = no enqueue and no call.
QA_OPERATIONS_BASE_URL=
QA_OPERATIONS_TOKEN=

# Draft insertion in the existing srv2066639.hstgr.cloud TLS server.
# Keep the UI/auth, Scanner callback and TLS configuration unchanged.
location ^~ /starter-bac-gateway/ {
    allow 46.101.105.87;
    deny all;
    client_max_body_size 8192;
    proxy_pass http://127.0.0.1:8794/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;
}

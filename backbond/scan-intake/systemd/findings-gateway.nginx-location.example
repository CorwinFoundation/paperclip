# Complete evidence handoff only; the legacy gateway retains its 8192-byte cap.
location ^~ /starter-bac-gateway/findings/v1/workflows {
    allow 46.101.105.87;
    deny all;
    client_max_body_size 2m;
    proxy_pass http://127.0.0.1:8794/findings/v1/workflows;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;
}

         self.assertAlmostEqual(_f_caveat(5), 1.25)
 
 
+class UnrecognizedAdmittanceClassFailsClosed(unittest.TestCase):
+    """Code-review F2 — quote() must fail closed on any admittance_class it does
+    not recognize, instead of falling through to the full rated (AUTO_BIND-
+    equivalent) path with f_caveat=1.0. A corrupted or case-variant decision
+    (e.g. a persisted REFUSE re-serialized as lowercase 'refuse') must never be
+    auto-priced as a normal bind.
+    """
+
+    def setUp(self):
+        self.rates = Rates.load(RATES_PATH)
+
+    def _decision(self, klass):
+        return {
+            "admittance_class": klass,
+            "firing_rule_id": "ADM.RX",
+            "are_total": 90,
+        }
+
+    def test_lowercase_refuse_is_not_priced(self):
+        # Regression for the exact scenario in the review: a REFUSE decision
+        # persisted with a lowercase class field must not price normally.
+        with self.assertRaises(ManualReferral) as ctx:
+            quote(_score(90), STD_CUSTOMER, rates=self.rates,
+                  admittance_decision=self._decision("refuse"))
+        self.assertNotIn("annual_premium_usd", ctx.exception.breakdown)
+        self.assertEqual(ctx.exception.breakdown["admittance"]["admittance_class"], "refuse")
+
+    def test_unknown_class_string_is_not_priced(self):
+        with self.assertRaises(ManualReferral):
+            quote(_score(90), STD_CUSTOMER, rates=self.rates,
+                  admittance_decision=self._decision("BIND_EVERYTHING"))
+
+    def test_none_class_is_not_priced(self):
+        with self.assertRaises(ManualReferral):
+            quote(_score(90), STD_CUSTOMER, rates=self.rates,
+                  admittance_decision=self._decision(None))
+
+    def test_recognized_classes_still_price(self):
+        # Guard against over-firing: AUTO_BIND and CONSTRAINED_BIND must still
+        # produce a quote (a premium), not a referral.
+        q = quote(_score(90, na_dims=[], measured_dims=["P2.1", "P2.3", "P2.4", "P2.5", "P2.6", "P3.1"]),
+                  STD_CUSTOMER, rates=self.rates,
+                  admittance_decision=self._decision("AUTO_BIND"))
+        self.assertIn("annual_premium_usd", q)
+
+
 if __name__ == "__main__":
     unittest.main()

diff --git a/pricing/quote.py b/pricing/quote.py
index 0a6b468..e98ddb5 100644
--- a/pricing/quote.py
+++ b/pricing/quote.py
@@ -621,6 +621,21 @@ def quote(
                 breakdown={"admittance": decision_dict, "evidence": evidence, "rates_version": rates.version},
             )
 
+        # BEAAA-review fail-closed default (code-review F2): every admittance
+        # class must be one of the four recognized values. REFUSE / REFER_TO_UW
+        # are handled above; only CONSTRAINED_BIND / AUTO_BIND may proceed to the
+        # rated path. Any other value — None, a case-variant ("refuse"), a typo,
+        # or a corrupted serialized intake record — must NOT fall through and be
+        # priced as a normal full-limit bind. Fail closed to manual UW review so
+        # a declined/unknown decision can never be auto-quoted.
+        if klass not in {"CONSTRAINED_BIND", "AUTO_BIND"}:
+            raise ManualReferral(
+                f"admittance class {klass!r} is not a recognized bind class "
+                f"(rule {rule_id}); refusing to price on an unrecognized or "
+                f"corrupted admittance decision — fail-closed (ADR-0007 §1.3).",
+                breakdown={"admittance": decision_dict, "rates_version": rates.version},
+            )
+
     # v0.1.1 additive (BEAAA-70): round-trip scan_evidence_age_days and
     # pillar_floors through the quote breakdown so pricing engine and
     # report card share one canonical source for these values. Pricing

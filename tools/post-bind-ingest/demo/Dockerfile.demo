FROM python:3.12-slim@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/tools/post-bind-ingest/src:/app/tools/log-tracker/src \
    DEMO_ENVIRONMENT=container

WORKDIR /app

COPY api /app/api
COPY ci_plugin /app/ci_plugin
COPY harness /app/harness
COPY report_card /app/report_card
COPY rubric /app/rubric
COPY scanners /app/scanners
COPY scripts /app/scripts
COPY underwriting /app/underwriting
COPY tools/portal_v1/verify_v0_2.py /app/tools/portal_v1/verify_v0_2.py
COPY tools/probe-registry/active_registry.json /app/tools/probe-registry/active_registry.json
COPY artifacts/beaaa-15436/BackBond-logo-on-white.png /app/artifacts/beaaa-15436/BackBond-logo-on-white.png
COPY tests/fixtures/golden_agents/G1/eval_outputs.json /app/tests/fixtures/golden_agents/G1/eval_outputs.json
COPY tools/post-bind-ingest /app/tools/post-bind-ingest
COPY tools/log-tracker /app/tools/log-tracker

RUN python -m pip install --no-cache-dir pytest==9.0.3 pydantic==2.13.4 PyYAML==6.0.2 /app/tools/post-bind-ingest /app/tools/log-tracker \
    && find /app -type d \( -name '.pytest_cache' -o -name '__pycache__' -o -name '*.egg-info' \) -prune -exec rm -rf '{}' + \
    && find /app -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin demo \
    && mkdir -p /data/runs \
    && chown -R demo:demo /data

USER 10001:10001
EXPOSE 8765
VOLUME ["/data/runs"]

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c "import json,urllib.request; assert json.load(urllib.request.urlopen('http://127.0.0.1:8765/api/health', timeout=2))['status']=='ok'"

CMD ["python", "tools/post-bind-ingest/demo/app.py", "--host", "0.0.0.0", "--port", "8765", "--runs-dir", "/data/runs"]

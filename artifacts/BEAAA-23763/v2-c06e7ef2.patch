+    if text.strip() != RELEASE_SHA:
+        _fail("deploy_authorization: wrong_release")
+
+
+def consume_authorization(
+    directory: Path = STATE_DIR,
+    path: Path = ALLOW_PATH,
+    consumed: Path = CONSUMED_PATH,
+) -> str:
+    """Spend the one-shot grant. The rename is the atomic consumption."""
+    if os.geteuid() != 0:
+        _fail("deploy_authorization: not_root")
+    _validate_state_dir(directory)
+    _read_authorization(path)
+    try:
+        os.rename(path, consumed)
+    except OSError:
+        _fail("deploy_authorization: consume_failed")
+    return RELEASE_SHA
+
+
+def main(argv: list[str]) -> int:
+    if argv:
+        print("arguments: rejected", file=sys.stderr)
+        return 2
+    try:
+        configured = validate()
+    except (PreflightError, UnicodeError) as exc:
+        print(str(exc) if isinstance(exc, PreflightError) else "secret_file: invalid_encoding", file=sys.stderr)
+        return 1
+    print("secret_file: valid")
+    for name in configured:
+        print(f"{name}: configured")
+    try:
+        released = consume_authorization()
+    except PreflightError as exc:
+        print(str(exc), file=sys.stderr)
+        return 1
+    print(f"deploy_authorization: consumed {released}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))

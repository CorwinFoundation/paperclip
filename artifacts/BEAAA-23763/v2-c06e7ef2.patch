+#!/usr/bin/python3
+"""Validate the fixed passive-demo secret file without disclosing values, then
+consume the one-shot exact-d9 deployment authorization.
+
+BEAAA-23703 candidate. This is the only root action in the repaired gate and it
+keeps the fixed path, the zero-argument contract and the stdout contract of the
+helper it replaces, so `demo-real-agent/deploy.sh` at commit
+d9d680f53db7de263f026be5284c97229126872c calls it exactly as it does today and
+the existing single sudoers rule is unchanged.
+
+Added behaviour: after the names-only preflight has been reported, the helper
+requires a root-owned one-shot authorization naming exactly d9 and consumes it
+by a same-directory rename. Consumption is atomic, so a replay finds nothing and
+fails closed, and with nothing armed the helper exits non-zero before deploy.sh
+reaches docker. An authorization naming any other release is refused and left in
+place.
+
+The preflight is reported before the authorization is consumed so that an
+unarmed post-install verification still exercises and prints the secret boundary
+result, then stops with `deploy_authorization: absent`.
+"""
+
+from __future__ import annotations
+
+import os
+import stat
+import sys
+from pathlib import Path
+
+
+ENV_PATH = Path("/etc/backbond/real-agent-demo.env")
+JUDGE_SOCKET_PATH = Path("/run/backbond-claude-judge/judge.sock")
+EXPECTED_UID = 10001
+EXPECTED_GID = 10001
+EXPECTED_MODE = 0o600
+
+RELEASE_SHA = "d9d680f53db7de263f026be5284c97229126872c"
+STATE_DIR = Path("/etc/backbond")
+ALLOW_PATH = Path("/etc/backbond/real-agent-demo-deploy.allow")
+CONSUMED_PATH = Path("/etc/backbond/real-agent-demo-deploy.consumed")
+AUTH_UID = 0
+AUTH_GID = 0
+AUTH_MODE = 0o600
+AUTH_MAX_BYTES = 128
+
+
+class PreflightError(Exception):
+    pass
+
+
+def _fail(status: str) -> None:
+    raise PreflightError(status)
+
+
+def _read_fixed_file(path: Path = ENV_PATH) -> str:
+    try:
+        before = path.lstat()
+    except FileNotFoundError:
+        _fail("secret_file: missing")
+    if not stat.S_ISREG(before.st_mode):
+        _fail("secret_file: not_regular")
+    if (before.st_uid, before.st_gid) != (EXPECTED_UID, EXPECTED_GID):
+        _fail("secret_file: wrong_owner")
+    if stat.S_IMODE(before.st_mode) != EXPECTED_MODE:
+        _fail("secret_file: wrong_mode")
+
+    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
+    try:
+        fd = os.open(path, flags)
+    except OSError:
+        _fail("secret_file: open_rejected")
+    try:
+        opened = os.fstat(fd)
+        if not stat.S_ISREG(opened.st_mode):
+            _fail("secret_file: opened_not_regular")
+        if (opened.st_uid, opened.st_gid) != (EXPECTED_UID, EXPECTED_GID):
+            _fail("secret_file: opened_wrong_owner")
+        if stat.S_IMODE(opened.st_mode) != EXPECTED_MODE:
+            _fail("secret_file: opened_wrong_mode")
+        if (opened.st_dev, opened.st_ino) != (
+            before.st_dev,
+            before.st_ino,
+        ):
+            _fail("secret_file: changed_during_check")
+        with os.fdopen(fd, "r", encoding="utf-8", errors="strict") as handle:
+            fd = -1
+            return handle.read()
+    finally:
+        if fd >= 0:
+            os.close(fd)
+
+
+def _parse_names(text: str) -> dict[str, str]:
+    values: dict[str, str] = {}
+    for raw_line in text.splitlines():
+        line = raw_line.strip()
+        if not line or line.startswith("#") or "=" not in line:
+            continue
+        name, value = line.split("=", 1)
+        name = name.strip()
+        if name:
+            values[name] = value.strip()
+    return values
+
+
+def validate(path: Path = ENV_PATH) -> list[str]:
+    values = _parse_names(_read_fixed_file(path))
+    configured: list[str] = []
+    for name in ("DEMO_ACCESS_TOKEN", "ARE_BUNDLE_SIGNING_KEY"):
+        if not values.get(name):
+            _fail(f"{name}: missing_or_empty")
+        configured.append(name)
+
+    if values.get("DEMO_JUDGE_BACKEND") == "claude-code-proxy":
+        if not values.get("CLAUDE_JUDGE_PROXY_TOKEN"):
+            _fail("CLAUDE_JUDGE_PROXY_TOKEN: missing_or_empty")
+        configured.extend(("DEMO_JUDGE_BACKEND", "CLAUDE_JUDGE_PROXY_TOKEN"))
+    else:
+        api_names = [
+            name
+            for name in ("OPENROUTER_API_KEY", "ANTHROPIC_API_KEY")
+            if values.get(name)
+        ]
+        if not api_names:
+            _fail("judge_configuration: missing_or_invalid")
+        configured.extend(api_names)
+    return configured
+
+
+def judge_socket_status(path: Path = JUDGE_SOCKET_PATH) -> str:
+    """Return only a readiness name for the fixed root-visible socket path."""
+    try:
+        mode = path.lstat().st_mode
+    except FileNotFoundError:
+        return "missing"
+    except OSError:
+        _fail("JUDGE_SOCKET: evaluation_failed")
+    return "ready" if stat.S_ISSOCK(mode) else "missing"
+
+
+def _validate_state_dir(directory: Path = STATE_DIR) -> None:
+    try:
+        st = directory.lstat()
+    except FileNotFoundError:
+        _fail("deploy_authorization: state_dir_missing")
+    if not stat.S_ISDIR(st.st_mode):
+        _fail("deploy_authorization: state_dir_not_directory")
+    if (st.st_uid, st.st_gid) != (AUTH_UID, AUTH_GID):
+        _fail("deploy_authorization: state_dir_wrong_owner")
+    if stat.S_IMODE(st.st_mode) & 0o022:
+        _fail("deploy_authorization: state_dir_writable")
+
+
+def _read_authorization(path: Path = ALLOW_PATH) -> None:
+    """Require a root-owned one-shot grant naming exactly the pinned release."""
+    try:
+        before = path.lstat()
+    except FileNotFoundError:
+        _fail("deploy_authorization: absent")
+    if not stat.S_ISREG(before.st_mode):
+        _fail("deploy_authorization: not_regular")
+    if (before.st_uid, before.st_gid) != (AUTH_UID, AUTH_GID):
+        _fail("deploy_authorization: wrong_owner")
+    if stat.S_IMODE(before.st_mode) != AUTH_MODE:
+        _fail("deploy_authorization: wrong_mode")
+
+    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
+    try:
+        fd = os.open(path, flags)
+    except OSError:
+        _fail("deploy_authorization: open_rejected")
+    try:
+        opened = os.fstat(fd)
+        if not stat.S_ISREG(opened.st_mode):
+            _fail("deploy_authorization: opened_not_regular")
+        if (opened.st_uid, opened.st_gid) != (AUTH_UID, AUTH_GID):
+            _fail("deploy_authorization: opened_wrong_owner")
+        if stat.S_IMODE(opened.st_mode) != AUTH_MODE:
+            _fail("deploy_authorization: opened_wrong_mode")
+        if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
+            _fail("deploy_authorization: changed_during_check")
+        payload = os.read(fd, AUTH_MAX_BYTES + 1)
+    finally:
+        os.close(fd)
+
+    if len(payload) > AUTH_MAX_BYTES:
+        _fail("deploy_authorization: oversized")
+    try:
+        text = payload.decode("ascii")
+    except UnicodeDecodeError:
+        _fail("deploy_authorization: not_ascii")
+    if text.strip() != RELEASE_SHA:
+        _fail("deploy_authorization: wrong_release")
+
+
+def consume_authorization(
+    directory: Path = STATE_DIR,
+    path: Path = ALLOW_PATH,
+    consumed: Path = CONSUMED_PATH,
+) -> str:
+    """Spend the one-shot grant. The rename is the atomic consumption."""
+    if os.geteuid() != 0:
+        _fail("deploy_authorization: not_root")
+    _validate_state_dir(directory)
+    _read_authorization(path)
+    try:
+        os.rename(path, consumed)
+    except OSError:
+        _fail("deploy_authorization: consume_failed")
+    return RELEASE_SHA
+
+
+def main(argv: list[str]) -> int:
+    if argv:
+        print("arguments: rejected", file=sys.stderr)
+        return 2
+    try:
+        configured = validate()
+    except (PreflightError, UnicodeError) as exc:
+        print(str(exc) if isinstance(exc, PreflightError) else "secret_file: invalid_encoding", file=sys.stderr)
+        return 1
+    print("secret_file: valid")
+    for name in configured:
+        print(f"{name}: configured")
+    if "DEMO_JUDGE_BACKEND" in configured:
+        try:
+            socket_status = judge_socket_status()
+        except PreflightError as exc:
+            print(str(exc), file=sys.stderr)
+            return 1
+        print(f"JUDGE_SOCKET: {socket_status}")
+    try:
+        released = consume_authorization()
+    except PreflightError as exc:
+        print(str(exc), file=sys.stderr)
+        return 1
+    print(f"deploy_authorization: consumed {released}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))

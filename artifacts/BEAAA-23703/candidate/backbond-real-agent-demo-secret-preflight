#!/usr/bin/python3
"""The only privileged step of the exact d9 Real Agent demo deployment.

`demo-real-agent/deploy.sh` at commit d9d680f53db7de263f026be5284c97229126872c
invokes this helper as `sudo --non-interactive
/usr/local/sbin/backbond-real-agent-demo-secret-preflight`, with no arguments.
It takes no arguments, reads no caller-supplied state, executes nothing, and
prints no secret value. It proves the protected environment and the pinned
release tree, then atomically consumes a root-owned one-shot authorization for
that one SHA. A second run without a freshly created authorization fails.
"""

import hashlib
import json
import os
from pathlib import Path
import stat
import sys
import time

SHA = "d9d680f53db7de263f026be5284c97229126872c"
RELEASE_DIR = Path(f"/opt/backbond-real-agent-demo/releases/{SHA}")
ARCHIVE_NAME = "real-agent-demo-release.tgz"

ENV_FILE = Path("/etc/backbond/real-agent-demo.env")
ENV_UID = 10001
ENV_GID = 10001
ENV_MODE = 0o600

ARM_FILE = Path("/etc/backbond/real-agent-demo-deploy.allow")
CONSUMED_DIR = Path("/etc/backbond/real-agent-demo-deploy-consumed")
ARM_UID = 0
ARM_GID = 0

EXPECTED_FILES = 906
EXPECTED_TREE_SHA256 = "5d6398a3cbf567778a8ca9ae7254b82a286a782dbd2874f0f711e9292bf16c17"

ALWAYS_REQUIRED = ("DEMO_ACCESS_TOKEN", "ARE_BUNDLE_SIGNING_KEY")
PROXY_BACKEND = b"claude-code-proxy"


def fail(message: str) -> "NoReturn":
    print(f"real-agent-demo secret preflight: {message}", file=sys.stderr)
    raise SystemExit(1)


def read_no_follow(path: Path) -> bytes:
    """Read a file without traversing a symlink planted in its place."""
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        chunks = []
        while True:
            chunk = os.read(descriptor, 1 << 20)
            if not chunk:
                return b"".join(chunks)
            chunks.append(chunk)
    finally:
        os.close(descriptor)


def env_preflight() -> tuple[str, bool]:
    """Prove the protected environment by metadata and name, never by value."""
    try:
        st = ENV_FILE.lstat()
    except OSError:
        fail("protected environment file is unavailable")
    if not stat.S_ISREG(st.st_mode):
        fail("protected environment file is not a regular file")
    if stat.S_IMODE(st.st_mode) != ENV_MODE or st.st_uid != ENV_UID or st.st_gid != ENV_GID:
        fail(
            "protected environment metadata does not match "
            f"uid/gid {ENV_UID}/{ENV_GID} and mode {ENV_MODE:04o}"
        )
    data = read_no_follow(ENV_FILE)
    present: set[str] = set()
    backend = b""
    for line in data.splitlines():
        if not line or line.lstrip().startswith(b"#") or b"=" not in line:
            continue
        name, value = line.split(b"=", 1)
        try:
            decoded = name.decode("ascii")
        except UnicodeDecodeError:
            fail("protected environment contains a non-ASCII variable name")
        if value:
            present.add(decoded)
        if decoded == "DEMO_JUDGE_BACKEND":
            backend = value.strip().strip(b"'\"")
    for required in ALWAYS_REQUIRED:
        if required not in present:
            fail(f"protected environment is missing required name {required}")
    proxy = backend == PROXY_BACKEND
    if proxy:
        if "CLAUDE_JUDGE_PROXY_TOKEN" not in present:
            fail("protected environment is missing required name CLAUDE_JUDGE_PROXY_TOKEN")
    elif not present & {"OPENROUTER_API_KEY", "ANTHROPIC_API_KEY"}:
        fail("protected environment is missing an API judge name")
    return hashlib.sha256(data).hexdigest(), proxy


def tree_digest(root: Path) -> tuple[int, str]:
    """Hash the extracted release without following any symlink it contains."""
    records: list[tuple[bytes, bytes, bytes]] = []
    for current, dirs, files in os.walk(root, topdown=True, followlinks=False):
        base = Path(current)
        for name in list(dirs):
            path = base / name
            if path.is_symlink():
                dirs.remove(name)
                rel = path.relative_to(root).as_posix().encode()
                digest = hashlib.sha256(os.readlink(path).encode()).hexdigest().encode()
                records.append((rel, b"L", digest))
        for name in files:
            path = base / name
            rel = path.relative_to(root).as_posix()
            if rel == ARCHIVE_NAME:
                continue
            if path.is_symlink():
                kind, data = b"L", os.readlink(path).encode()
            else:
                try:
                    kind, data = b"F", read_no_follow(path)
                except OSError:
                    fail(f"unsupported release entry: {rel}")
            records.append((rel.encode(), kind, hashlib.sha256(data).hexdigest().encode()))
    digest = hashlib.sha256()
    for rel, kind, content_hash in sorted(records):
        digest.update(rel + b"\0" + kind + b"\0" + content_hash + b"\0")
    return len(records), digest.hexdigest()


def verify_release() -> str:
    try:
        st = RELEASE_DIR.lstat()
    except OSError:
        fail("pinned release directory is absent")
    if not stat.S_ISDIR(st.st_mode):
        fail("pinned release path is not a directory")
    count, digest = tree_digest(RELEASE_DIR)
    if count != EXPECTED_FILES or digest != EXPECTED_TREE_SHA256:
        fail(f"release tree is not the pinned d9 tree: files={count} tree_sha256={digest}")
    if not (RELEASE_DIR / "demo-real-agent/deploy.sh").is_file():
        fail("pinned release deploy script is absent")
    return digest


def consume_authorization() -> Path:
    """Atomically spend the root-owned one-shot authorization for this SHA."""
    try:
        st = ARM_FILE.lstat()
    except OSError:
        fail(
            "deployment is not authorized: a host owner must create "
            f"{ARM_FILE} (root-owned, mode 0600) containing exactly the pinned SHA"
        )
    if not stat.S_ISREG(st.st_mode):
        fail("deployment authorization is not a regular file")
    if st.st_uid != ARM_UID or st.st_gid != ARM_GID:
        fail("deployment authorization is not root-owned")
    if stat.S_IMODE(st.st_mode) != 0o600:
        fail("deployment authorization mode is not 0600")
    if st.st_nlink != 1:
        fail("deployment authorization has more than one link")
    try:
        value = read_no_follow(ARM_FILE).decode("ascii").strip()
    except (OSError, UnicodeDecodeError):
        fail("deployment authorization could not be read as ASCII")
    if value != SHA:
        fail("deployment authorization does not name the pinned SHA")
    CONSUMED_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chown(CONSUMED_DIR, 0, 0)
    os.chmod(CONSUMED_DIR, 0o700)
    receipt = CONSUMED_DIR / f"{SHA}-{time.time_ns()}"
    try:
        os.rename(ARM_FILE, receipt)
    except OSError:
        fail("deployment authorization was already consumed")
    os.chmod(receipt, 0o600)
    return receipt


def main() -> None:
    if len(sys.argv) != 1:
        fail("this helper accepts no arguments")
    if os.geteuid() != 0:
        fail("must run through the configured sudo boundary")
    env_hash, proxy = env_preflight()
    tree_sha256 = verify_release()
    receipt = consume_authorization()
    (receipt.with_suffix(".receipt")).write_text(
        json.dumps(
            {
                "sha": SHA,
                "files": EXPECTED_FILES,
                "tree_sha256": tree_sha256,
                "env_sha256": env_hash,
                "consumed_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                "values_exposed": False,
            },
            indent=2,
            sort_keys=True,
        )
        + "\n"
    )
    os.chmod(receipt.with_suffix(".receipt"), 0o600)
    print(f"secret_preflight=PASS sha={SHA}")
    print(f"release: files={EXPECTED_FILES} tree_sha256={tree_sha256}")
    print(f"environment: uid={ENV_UID} gid={ENV_GID} mode=0600 sha256={env_hash}")
    print("required_names: PASS")
    print("DEMO_JUDGE_BACKEND: " + ("configured" if proxy else "api"))
    print(f"authorization: consumed receipt={receipt.name}")
    print("values_exposed: false")


if __name__ == "__main__":
    main()

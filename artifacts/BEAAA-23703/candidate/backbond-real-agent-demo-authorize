#!/usr/bin/python3
"""Atomically consume the one-shot d9 deployment authorization.

BEAAA-23703 candidate. This is the only root action in the repaired gate. It
takes no arguments, reads no repository content, executes nothing, and is
pinned to exactly one release:

    commit d9d680f53db7de263f026be5284c97229126872c

The authorization is a root-owned 0600 file holding that SHA. Consuming it is a
same-directory rename, so it is atomic and cannot be replayed: the second call
finds no authorization and fails closed. A file holding any other SHA is
refused and left in place.

Exit status 0 with "authorized: <sha>" on stdout means the one-shot grant for
d9 was consumed by this call. Any other outcome is a denial.
"""

import os
import stat
import sys

EXPECTED_SHA = "d9d680f53db7de263f026be5284c97229126872c"
STATE_DIR = "/etc/backbond"
ALLOW_PATH = "/etc/backbond/real-agent-demo-deploy.allow"
CONSUMED_PATH = "/etc/backbond/real-agent-demo-deploy.consumed"
EXPECTED_UID = 0
EXPECTED_GID = 0
EXPECTED_MODE = 0o600
MAX_BYTES = 128


class AuthorizationError(Exception):
    pass


def _validate_state_dir(path=STATE_DIR):
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        raise AuthorizationError("state_dir_missing")
    if not stat.S_ISDIR(st.st_mode):
        raise AuthorizationError("state_dir_not_directory")
    if st.st_uid != EXPECTED_UID or st.st_gid != EXPECTED_GID:
        raise AuthorizationError("state_dir_wrong_owner")
    if stat.S_IMODE(st.st_mode) & 0o022:
        raise AuthorizationError("state_dir_writable")


def _read_authorization(path=ALLOW_PATH):
    try:
        before = os.lstat(path)
    except FileNotFoundError:
        raise AuthorizationError("absent")
    if not stat.S_ISREG(before.st_mode):
        raise AuthorizationError("not_regular")
    if before.st_uid != EXPECTED_UID or before.st_gid != EXPECTED_GID:
        raise AuthorizationError("wrong_owner")
    if stat.S_IMODE(before.st_mode) != EXPECTED_MODE:
        raise AuthorizationError("wrong_mode")

    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        opened = os.fstat(fd)
        # Revalidate the opened descriptor itself, not just the pre-open lstat:
        # inode identity alone does not guard same-inode metadata changes.
        if not stat.S_ISREG(opened.st_mode):
            raise AuthorizationError("opened_not_regular")
        if opened.st_uid != EXPECTED_UID or opened.st_gid != EXPECTED_GID:
            raise AuthorizationError("opened_wrong_owner")
        if stat.S_IMODE(opened.st_mode) != EXPECTED_MODE:
            raise AuthorizationError("opened_wrong_mode")
        if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
            raise AuthorizationError("changed_during_check")
        payload = os.read(fd, MAX_BYTES + 1)
    finally:
        os.close(fd)

    if len(payload) > MAX_BYTES:
        raise AuthorizationError("oversized")
    try:
        text = payload.decode("ascii")
    except UnicodeDecodeError:
        raise AuthorizationError("not_ascii")
    if text.strip() != EXPECTED_SHA:
        raise AuthorizationError("wrong_release")


def _consume(path=ALLOW_PATH, consumed=CONSUMED_PATH):
    try:
        os.rename(path, consumed)
    except OSError:
        raise AuthorizationError("consume_failed")


def authorize(state_dir=STATE_DIR, path=ALLOW_PATH, consumed=CONSUMED_PATH):
    _validate_state_dir(state_dir)
    _read_authorization(path)
    _consume(path, consumed)
    return EXPECTED_SHA


def main(argv):
    if len(argv) != 1:
        sys.stderr.write("arguments: rejected\n")
        return 2
    if os.geteuid() != 0:
        sys.stderr.write("authorization: not_root\n")
        return 2
    try:
        released = authorize()
    except AuthorizationError as exc:
        sys.stderr.write("authorization: %s\n" % exc.args[0])
        return 1
    sys.stdout.write("authorized: %s\n" % released)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

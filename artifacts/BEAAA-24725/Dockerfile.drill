# Clean-host substrate for the BEAAA-24725 Part C drill ONLY.
# The CTO ruled the container out of P1 scope as a *deployment mechanism*
# (BEAAA-24623 ruling 2): systemd + PRODUCTION-INGEST.md is the approved path.
# This image exists so that path can be executed on a host prepared by nothing
# but those steps, under real systemd and real root. Nothing here is installed
# for the service; the drill's own transcript does all of that from the doc.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus python3 python3-venv python3-pip unzip curl ca-certificates \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]

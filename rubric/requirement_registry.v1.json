  "test_catalog": {
    "operational_oversight": {
      "probe_set_version": "operational-controls@1",
      "case_ids": [
        "OPS-APPROVAL-DENIED",
        "OPS-APPROVAL-ALLOWED",
        "OPS-APPROVAL-REVOKED",
        "OPS-APPROVAL-REPLAY",
        "OPS-APPROVAL-ARGUMENTS",
        "OPS-STOP",
        "OPS-HANDOFF",
        "OPS-ROLLBACK"
      ]
    },
    "operational_logging": {
      "probe_set_version": "operational-controls@1",
      "case_ids": [
        "OPS-LOG-COMPLETENESS",
        "OPS-LOG-ORDER",
        "OPS-LOG-IDENTITY",
        "OPS-ALERT-DELIVERY"
      ]
    },
    "operational_logging_quality": {
      "probe_set_version": "operational-log-quality@1",
      "case_ids": [
        "OPS-LOG-PAYLOAD",
        "OPS-LOG-TIME",
        "OPS-LOG-BATCH",
        "OPS-LOG-REPEAT",
        "OPS-ALERT-SELECTIVITY"
      ],
      "case_methods": {
        "OPS-LOG-PAYLOAD": "Preserve typed nested diagnostic payloads, including Unicode and null values.",
        "OPS-LOG-TIME": "Preserve timezone-aware source event instants and event order metadata.",
        "OPS-LOG-BATCH": "Retrieve each of two independently identified diagnostic batches without mixing them.",
        "OPS-LOG-REPEAT": "Return the same diagnostic records on two immediate reads; not a retention test.",
        "OPS-ALERT-SELECTIVITY": "Deliver a failure alert to the configured recipient, with no delivered alert for a success-only batch."
      }
    },
    "operational_logging_challenges": {
      "probe_set_version": "operational-log-challenges@1",
      "case_ids": [
        "OPS-LOG-INTERLEAVED",
        "OPS-LOG-EMPTY-LOOKUP",
        "OPS-LOG-BOUNDARY"
      ],
      "case_methods": {
        "OPS-LOG-INTERLEAVED": "Retrieve two interleaved diagnostic batches independently.",
        "OPS-LOG-EMPTY-LOOKUP": "Return no records for a never-emitted batch, alongside a positive retrieval control.",
        "OPS-LOG-BOUNDARY": "Preserve bounded larger typed and Unicode diagnostic payloads without clipping."
      }
    },
    "assessment_risk_traceability": {
      "probe_set_version": "assessment-record-checks@1",
      "case_ids": [
        "EVID-RISK-TRACE"
      ],
      "case_methods": {
        "EVID-RISK-TRACE": "Reconcile risk, treatment and verification references, ownership and closure claims."
      }
    },
    "assessment_data_lineage": {
      "probe_set_version": "assessment-record-checks@1",
      "case_ids": [
        "EVID-DATA-LINEAGE"
      ],
      "case_methods": {
        "EVID-DATA-LINEAGE": "Reconcile dataset hashes, parent lineage, declared permission references and approved row-quality rules."
      }
    },
    "assessment_evaluation_reconciliation": {
      "probe_set_version": "assessment-record-checks@1",
      "case_ids": [
        "EVID-EVAL-RESULTS"
      ],
      "case_methods": {
        "EVID-EVAL-RESULTS": "Recompute exact-match accuracy from labelled rows and bound observations against an approved threshold."
      }
    },
    "assessment_subgroup_coverage": {
      "probe_set_version": "assessment-record-checks@1",
      "case_ids": [
        "EVID-SUBGROUP-COVERAGE"
      ],
      "case_methods": {
        "EVID-SUBGROUP-COVERAGE": "Recompute approved subgroup sample coverage and accuracy disparity from bound labelled observations."
      }
    },
    "assessment_change_comparison": {
      "probe_set_version": "assessment-record-checks@1",
      "case_ids": [
        "EVID-CHANGE-REGRESSION"
      ],
      "case_methods": {
        "EVID-CHANGE-REGRESSION": "Compare baseline and current exact-match results for the same labelled dataset and probe version."
      }
    },
    "assessment_incident_closure": {
      "probe_set_version": "assessment-record-checks@1",
      "case_ids": [
        "EVID-INCIDENT-CLOSURE"
      ],
      "case_methods": {
        "EVID-INCIDENT-CLOSURE": "Reconcile incident and corrective-action references, closure verification and chronology."
      }
    }
  },

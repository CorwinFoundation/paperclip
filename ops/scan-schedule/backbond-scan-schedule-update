#!/bin/sh
# Fast-forward the scan checkout, then make the installed units match it.
#
# BEAAA-35698: the nightly model-zoo scan was dead from 2026-09-12 to
# 2026-09-25 on
#
#   PermissionError: [Errno 13] Permission denied: /var/lib/backbond/scans/.worker-home
#
# That is the same failure BEAAA-30934 diagnosed on the weekly Vapi lane, with
# the same cause: /etc/systemd/system held a pre-#558 copy of the unit, so
# `HOME` was unset and `_ensure_worker_home()` died EACCES on the 0750 parent.
# The repair had been in the repo since 0dca4c9e4 and never reached the box.
#
# BEAAA-30934 built both halves of the answer -- check-unit-drift.sh to detect
# it and install-units-only.sh to repair it -- and then wired neither to
# anything, on the stated grounds that the scan units must invoke no helper of
# this kind.  That decision stands and is pinned by
# tests/test_scheduled_scan_beaaa30240.py.  The consequence was that a detector
# existed for thirteen days while the drift it detects went unnoticed, because
# nothing ran it.
#
# This script is where it runs.  Fast-forwarding the checkout is the exact
# moment unit files can start to differ from the ones under /etc, so the check
# belongs on the other side of the merge.  It is invoked by an operator, not by
# a unit, so it clears the constraint above.
#
# As root it repairs and re-checks; unprivileged it reports and exits non-zero
# so the drift is visible rather than silent.
#
# Timer scoping, which is load-bearing and not incidental.  Repairing the units
# un-breaks the weekly VAPI lane as a side effect, and that lane is currently
# failing closed only by accident: `backbond-scan-vapi.timer` is enabled and
# active with `Persistent=true` and `OnCalendar=Mon *-*-* 03:00:00 UTC`, and
# `/etc/backbond/scan-schedule.conf` points
# `BACKBOND_SCAN_AGENT_ENDPOINT` at https://api.vapi.ai -- live production.
# BEAAA-32522's release boundary forbids new VAPI traffic without a current
# written authorization and the July one lapsed; the 2026-09-14 and 2026-09-21
# firings sent nothing only because the drifted unit exits 1.  So this script
# disarms that one timer, by name, before it repairs anything.  Repair first
# and an aborted run leaves the lane armed.
#
# The zoo timer is enabled, by name, and never started: `--now` on either
# timer, and a bare `start` on a timer whose stamp is stale, fires an immediate
# Persistent catch-up run (BEAAA-30240).  No glob, no loop, no
# `backbond-scan-*.timer` -- the unit list is spelled out so a future unit
# cannot be armed by being added to the directory (BEAAA-35698, CEO constraint
# 2026-09-25).
#
# Usage:  backbond-scan-schedule-update [checkout_dir] [unit_dir]
set -eu

checkout=${1:-/opt/backbond/src}
default_unit_dir=/etc/systemd/system
unit_dir=${2:-$default_unit_dir}

test -d "$checkout/.git"

# Refreshing the checkout is a root action: /opt/backbond/src is not writable by
# an ordinary operator, so `git fetch` there dies EACCES on .git/FETCH_HEAD.
# Attempting it first made the unprivileged path abort under `set -e` before it
# ever reached the drift check, which is the opposite of the reporting mode this
# script promises. Unprivileged, report on the checkout as it stands and say so.
if [ "$(id -u)" -eq 0 ]; then
  git -C "$checkout" fetch --quiet origin master
  git -C "$checkout" merge --ff-only --quiet origin/master
else
  echo 'Not root: reporting against the checkout as it stands, not refreshing it.' >&2
fi

schedule_dir="$checkout/ops/scan-schedule"
test -d "$schedule_dir" || { echo "missing $schedule_dir" >&2; exit 1; }

# Exactly one timer is disarmed and exactly one is armed, both by literal name.
# Enablement is global systemd state, so this is gated on operating against the
# real unit directory: a test run pointed at a temp dir must not touch it.
_scope_timers() {
  test "$unit_dir" = "$default_unit_dir" || return 0
  command -v systemctl >/dev/null 2>&1 || return 0

  # Disarm. `stop` on a timer unit triggers nothing; only starting one can.
  if [ "$(systemctl is-enabled backbond-scan-vapi.timer 2>/dev/null || true)" = enabled ]; then
    echo 'Disarming backbond-scan-vapi.timer: no current VAPI authorization (BEAAA-32522).'
    systemctl stop backbond-scan-vapi.timer
    systemctl disable backbond-scan-vapi.timer
  fi

  # Arm the nightly zoo lane.  `enable` alone only writes the
  # timers.target.wants symlink; the timer unit stays inactive until something
  # starts it, which is why this lane has never fired once --
  # `LastTriggerUSec` and `NextElapseUSecRealtime` are both empty (CEO
  # measurement, 2026-09-26).  Installing the corrected units fixes the
  # permission bug and still leaves the zoo dark.
  #
  # A bare `start` is not safe either.  The timer is `Persistent=true` with no
  # stamp file, so systemd treats the last calendar elapse as missed and
  # triggers the service the instant the timer starts -- a full zoo scan at
  # whatever moment an operator happens to run this script, against a funding
  # decision that is still open (BEAAA-31936).  Seeding the stamp first is what
  # makes the first trigger land on the next OnCalendar elapse, 03:30 UTC,
  # instead of immediately.  This is also why `--now` is banned rather than
  # merely avoided: it would start the timer before the stamp exists.
  systemctl enable backbond-scan-zoo.timer
  _seed_timer_stamp backbond-scan-zoo.timer
  systemctl start backbond-scan-zoo.timer
}

# systemd records a Persistent timer's last trigger as the mtime of
# /var/lib/systemd/timers/stamp-<unit>.  Absent means "never ran", which is a
# missed elapse.  Present and current means "ran just now", which is not a lie
# worth telling in general -- but this timer has no history to misreport, and
# the alternative is firing an unscheduled run to establish one.  An existing
# stamp is left alone.
_seed_timer_stamp() {
  stamp=/var/lib/systemd/timers/stamp-$1
  test ! -e "$stamp" || return 0
  install -d -m 0755 /var/lib/systemd/timers
  : > "$stamp"
  echo "Seeded $stamp so arming does not fire a catch-up run."
}

_assert_vapi_disarmed() {
  test "$unit_dir" = "$default_unit_dir" || return 0
  command -v systemctl >/dev/null 2>&1 || return 0
  if [ "$(systemctl is-enabled backbond-scan-vapi.timer 2>/dev/null || true)" = enabled ]; then
    echo 'backbond-scan-vapi.timer is still enabled after disable; refusing to leave it armed' >&2
    exit 1
  fi
}

if "$schedule_dir/check-unit-drift.sh" "$unit_dir"; then
  if [ "$(id -u)" -eq 0 ]; then
    _scope_timers
    _assert_vapi_disarmed
  fi
  echo 'Installed units match the checkout; nothing to repair.'
  exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
  echo 'Installed units have drifted from the checkout.' >&2
  echo "Repair with: sudo $schedule_dir/install-units-only.sh" >&2
  exit 1
fi

_scope_timers

echo 'Installed units have drifted from the checkout; repairing.'
"$schedule_dir/install-units-only.sh" "$unit_dir"

# Reinstalling a unit file does not restore a .wants symlink, but the whole
# point of this script is that assumptions about /etc go stale, so re-read it.
_assert_vapi_disarmed

# Prove the repair took rather than asserting it.  install-units-only.sh ends
# in the same check, but it is re-run here so this script's own exit status
# reports the state it leaves behind.
"$schedule_dir/check-unit-drift.sh" "$unit_dir"
echo 'Units repaired. backbond-scan-vapi.timer is disarmed; backbond-scan-zoo.timer is enabled, not started.'

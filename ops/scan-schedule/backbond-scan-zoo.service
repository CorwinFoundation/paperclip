[Unit]
Description=BackBond nightly model-zoo scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=are-deploy
EnvironmentFile=/etc/backbond/scan-schedule.env
EnvironmentFile=/etc/backbond/scan-schedule.conf
WorkingDirectory=/home/are-deploy/are-scanner
ExecStartPre=/usr/bin/git -C /home/are-deploy/are-scanner fetch --quiet origin master
ExecStartPre=/usr/bin/git -C /home/are-deploy/are-scanner merge --ff-only --quiet origin/master
ExecStart=/usr/bin/python3 scripts/scheduled_scan.py --job zoo

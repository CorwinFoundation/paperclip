[Unit]
Description=BackBond one-row Zoo authentication diagnostic (BEAAA-39322)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=backbond-scan
EnvironmentFile=/etc/backbond/scan-schedule.env
EnvironmentFile=/etc/backbond/scan-schedule.conf
WorkingDirectory=/opt/backbond/src
Environment=HOME=/var/lib/backbond/scan-home
ExecStartPre=+/bin/sh -c "chmod o+x /var/lib/backbond && install -d -o backbond-scan -g backbond-scan -m 0700 /var/lib/backbond/scan-home && install -d -o backbond-scan -g backbond-scan -m 0755 /var/lib/backbond/scans"
ExecStartPre=+/usr/bin/env HOME=/root /usr/bin/git -C /opt/backbond/src fetch --quiet origin master
ExecStartPre=+/usr/bin/env HOME=/root /usr/bin/git -C /opt/backbond/src merge --ff-only --quiet origin/master
ExecStart=/opt/backbond/scan-venv/bin/python scripts/scheduled_scan.py --job zoo --zoo-family advbench --zoo-case advbench.b2b_harmful

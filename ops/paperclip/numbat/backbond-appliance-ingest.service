[Unit]
Description=BackBond appliance counts/hashes-only ingest
After=network.target

[Service]
Type=simple
User=backbond
Group=backbond
EnvironmentFile=/etc/backbond/appliance-ingest.env
ExecStart=/opt/backbond/venv/bin/python -m log_tracker.appliance_ingest_server --host 127.0.0.1 --port 8787 --database /var/lib/backbond/log-tracker.sqlite3 --migration /opt/backbond/migrations/0001_log_tracker_v0.sql --migration /opt/backbond/migrations/0002_appliance_ingest.sql --migration /opt/backbond/migrations/0002_evidence_tier_assignment_v1.sql --migration /opt/backbond/migrations/0003_appliance_ingest_agents.sql --migration /opt/backbond/migrations/0004_appliance_binding.sql --migration /opt/backbond/migrations/0005_dimensional_counts.sql --sealed-root /opt/backbond/appliance-0.1.0 --enrollment-file /etc/backbond/appliance-enrollment.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/backbond

[Install]
WantedBy=multi-user.target

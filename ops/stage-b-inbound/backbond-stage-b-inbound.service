[Unit]
Description=BackBond Stage B inbound DEMO receiver
After=network.target

[Service]
Type=simple
User=backbond-stage-b
Group=backbond-stage-b
EnvironmentFile=/etc/backbond/stage-b-inbound.env
WorkingDirectory=/opt/backbond-stage-b/app
ExecStart=/usr/bin/python3 -m stage_b_pilot.mailgun --db /var/lib/backbond-stage-b/inbound.sqlite3 --host 127.0.0.1 --port 8788
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/backbond-stage-b

[Install]
WantedBy=multi-user.target

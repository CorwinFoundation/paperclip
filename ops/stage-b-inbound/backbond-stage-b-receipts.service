[Unit]
Description=BackBond Stage B private DEMO receipt page
After=network.target backbond-stage-b-inbound.service
Requires=backbond-stage-b-inbound.service

[Service]
Type=simple
User=backbond-stage-b
Group=backbond-stage-b
UMask=0077
EnvironmentFile=/etc/backbond/stage-b-receipts.env
WorkingDirectory=/opt/backbond-stage-b/app
EnvironmentFile=/etc/backbond/stage-b-receipts.env
ExecStart=/usr/bin/python3 -m stage_b_pilot.receipt_page --host 127.0.0.1 --port 8789 --upstream-host 127.0.0.1 --upstream-port 8788
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/backbond-stage-b

[Install]
WantedBy=multi-user.target

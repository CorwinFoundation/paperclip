{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateRetentionLockedReceiptsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectRetention",
        "s3:PutObject",
        "s3:PutObjectRetention"
      ],
      "Resource": "arn:aws:s3:::${RECEIPT_BUCKET}/receipts/v1/*"
    },
    {
      "Sid": "DenyDestructiveReceiptActions",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": "arn:aws:s3:::${RECEIPT_BUCKET}/receipts/v1/*"
    }
  ]
}

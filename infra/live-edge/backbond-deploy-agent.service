[Unit]
Description=BackBond approved release deploy agent
After=network-online.target docker.service backbond-docker-networking.service
Wants=network-online.target
Requires=docker.service
Requires=backbond-docker-networking.service

[Service]
ExecStartPre=/usr/local/sbin/backbond-ensure-docker-networking
Type=oneshot
User=root
UMask=0077
StateDirectory=backbond-deploy-agent
StateDirectoryMode=0700
WorkingDirectory=/opt/backbond/are-scanner
LoadCredentialEncrypted=deploy-token:/etc/credstore.encrypted/backbond-deploy-token
LoadCredentialEncrypted=paperclip-api-key:/etc/credstore.encrypted/backbond-paperclip-api-key
LoadCredential=deploy-authorization-id:/run/backbond-deploy-agent/authorization-id
LoadCredentialEncrypted=acceptance-admin-token:/etc/credstore.encrypted/backbond-acceptance-admin-token
EnvironmentFile=/etc/backbond/deploy-agent.conf
Environment=BACKBOND_DEPLOY_ENV=production
Environment=BACKBOND_DEPLOY_HOST=srv1749248
Environment=BACKBOND_DEPLOY_LEASE_PATH_TEMPLATE=/api/release-candidates/approved-lease?authorizationId={authorization_id}
Environment=BACKBOND_DEPLOY_RECORD_PATH=/api/release-candidates/deploy-records
ExecStart=/opt/backbond/are-scanner/infra/live-edge/run-backbond-deploy-agent
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/backbond-deploy-agent /run /etc/backbond
Environment=BACKBOND_SCAN_LOG_DB=/var/lib/are-scanner/scan_log.sqlite3
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
